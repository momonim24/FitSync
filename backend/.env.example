# ------------------------------------------------------------------
# FitSync backend environment configuration
# Copy this file to `.env` and fill in values for YOUR machine.
# Never commit the real `.env` file.
# ------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=fitsync_db
# Separate database used only by the automated e2e tests (it is wiped on every test run)
DB_TEST_NAME=fitsync_test_db

# JWT — generate a long random secret, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Security
BCRYPT_SALT_ROUNDS=10
# Max login attempts per IP address per minute
LOGIN_RATE_LIMIT=5
# Max requests per IP address per minute for all other endpoints
GLOBAL_RATE_LIMIT=300

# Development seed passwords (used only by `npm run db:seed`).
# Leave blank to have the seed script generate random passwords and print them once.
# Must be at least 8 characters and contain a letter and a number.
SEED_ADMIN_PASSWORD=
SEED_TRAINER_PASSWORD=
SEED_MEMBER_PASSWORD=

# External Fitness API (wger.de — the provider address itself is fixed in code)
# Request timeout in milliseconds and response cache lifetime in seconds
WGER_TIMEOUT_MS=8000
WGER_CACHE_TTL_SECONDS=600

# Application time zone for calendar days and local-time display (IANA name).
# Stored timestamps are always UTC; this only decides what "today" means.
APP_TIME_ZONE=Asia/Manila
